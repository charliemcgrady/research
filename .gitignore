lag3_validation/refs/
lag3_validation/runs_dv/*.log
lag3_validation/runs_dv/q_*.txt
lag3_validation/scrna/**/*.txt.gz
lag3_validation/scrna/**/*.rds.gz
lag3_validation/scrna/**/*.h5ad
__pycache__/
*.pyc
lag3_validation/scrna/**/*.log
lag3_validation/scrna/**/*.gtf.gz
